#
# ~/.config/ghostty/local: the settings of this machine. Ghostty reads this file after the
# shared config.ghostty, so a line here wins. install.sh writes it once and never again.
# Remove the "# " of a line to switch it on, then reload with Ctrl+Shift+comma.
# Check the result with: ghostty +validate-config

# The colour scheme, one line. Without a line here it is Tokyo Night Moon (tokyo-night-moon).
# theme = tokyo-night
# theme = tokyo-night-day
# theme = light:tokyo-night-day,dark:tokyo-night-moon
# theme = okabe-ito-ink
# theme = okabe-ito-paper
# theme = light:okabe-ito-paper,dark:okabe-ito-ink

# The size of the letters, in points. The shared value is 12. Where the desktop scales the text
# (see the window size below), a smaller value looks the same: at the scale 1.25, 10.5 is drawn
# like 13 points.
# font-size = 14

# Ligatures, which the shared file switches off: this line empties its list, and the font decides.
# font-feature = ""

# The size of a new window. The grid that a request gives is not the request. If GNOME (or
# another desktop) scales the text of the interface, Ghostty draws the letters at that scale but
# sizes the window from letters that are not scaled, so the grid is smaller than window-width by
# window-height: at the scale 1.25 a request of 96 columns gave 77. Where the text is not scaled
# the grid can be wider: a request of 96 gave 98 on one machine. So each machine asks for its own
# numbers with two lines, window-width and window-height, in this file. Their values depend on
# the scale, on font-size and on the title bar, and the grid moves in uneven steps, so they are
# measured: this command opens a few windows, reads the grid of each, and writes the two lines
# under a comment line that names the size they were measured for.
#   ~/workspace/my-cli-config/ghostty/fit-window.sh --write 96 25
# The scale of the text: gsettings get org.gnome.desktop.interface text-scaling-factor
# For example, the width that gives 96 columns is 120 at the scale 1.25 with font-size = 10.5, and
# 94 at the scale 1.0 with font-size = 12 on one machine.
